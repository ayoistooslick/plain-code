{
    "Remember variable": {
        "prefix": "rem",
        "body": ["remember ${1:name} as ${2:value}"],
        "description": "Declare a variable"
    },
    "Show value": {
        "prefix": "show",
        "body": ["show ${1:value}"],
        "description": "Print a value"
    },
    "If statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition} is ${2:value}",
            "    ${3:show \"yes\"}",
            "done"
        ],
        "description": "If block"
    },
    "If / otherwise": {
        "prefix": "ifo",
        "body": [
            "if ${1:condition} is ${2:value}",
            "    ${3:show \"yes\"}",
            "otherwise",
            "    ${4:show \"no\"}",
            "done"
        ],
        "description": "If / otherwise block"
    },
    "Make function": {
        "prefix": "make",
        "body": [
            "make ${1:name}(${2:params})",
            "    ${3:show \"hello\"}",
            "done"
        ],
        "description": "Declare a function"
    },
    "Make function with return": {
        "prefix": "makeg",
        "body": [
            "make ${1:name}(${2:a}, ${3:b})",
            "    give ${4:a + b}",
            "done"
        ],
        "description": "Declare a function with a return value"
    },
    "For each loop": {
        "prefix": "foreach",
        "body": [
            "for each ${1:item} in ${2:collection}",
            "    show ${1:item}",
            "done"
        ],
        "description": "For each loop"
    },
    "For every loop": {
        "prefix": "forevery",
        "body": [
            "for every ${1:item} in ${2:collection}",
            "    show ${1:item}",
            "done"
        ],
        "description": "For every loop (alias for for each)"
    },
    "While loop": {
        "prefix": "while",
        "body": [
            "while ${1:x} is less than ${2:10}",
            "    ${3:x becomes x + 1}",
            "done"
        ],
        "description": "While loop"
    },
    "Remember array": {
        "prefix": "rema",
        "body": [
            "remember ${1:items} as [",
            "    ${2:\"item1\"},",
            "    ${3:\"item2\"},",
            "]"
        ],
        "description": "Declare an array"
    },
    "Remember object": {
        "prefix": "remo",
        "body": [
            "remember ${1:obj} as",
            "    ${2:key} is ${3:\"value\"}",
            "done"
        ],
        "description": "Declare an object"
    },
    "Web app": {
        "prefix": "webapp",
        "body": [
            "web app",
            "",
            "route \"/\"",
            "    reply \"${1:Hello from PLINJS!}\"",
            "done",
            "",
            "start ${2:3000}"
        ],
        "description": "Web app boilerplate (v0.6)"
    },
    "Route": {
        "prefix": "route",
        "body": [
            "route \"${1:/path}\"",
            "    reply ${2:\"Hello\"}",
            "done"
        ],
        "description": "Define a route (v0.6)"
    },
    "Express app (classic)": {
        "prefix": "express",
        "body": [
            "use express",
            "",
            "remember app as express()",
            "",
            "when someone visits \"${1:/}\"",
            "    reply \"${2:Hello from PLINJS!}\"",
            "done",
            "",
            "listen on ${3:3000}",
            "    show \"Server running on port ${3:3000}\"",
            "done"
        ],
        "description": "Classic Express app boilerplate"
    },
    "Database": {
        "prefix": "database",
        "body": [
            "database \"${1:app.db}\"",
            "",
            "execute",
            "    CREATE TABLE IF NOT EXISTS ${2:items} (id INTEGER PRIMARY KEY, ${3:name} TEXT)",
            "done"
        ],
        "description": "SQLite database setup (v0.6)"
    },
    "Query": {
        "prefix": "query",
        "body": [
            "query",
            "    SELECT * FROM ${1:table}",
            "done"
        ],
        "description": "SQL query block (v0.6)"
    },
    "Between comparison": {
        "prefix": "between",
        "body": ["if ${1:x} between ${2:1} and ${3:10}"],
        "description": "Between comparison (v0.6)"
    },
    "Contains check": {
        "prefix": "contains",
        "body": ["if ${1:text} contains ${2:\"word\"}"],
        "description": "String contains check (v0.6)"
    },
    "JSON encode/decode": {
        "prefix": "json",
        "body": [
            "remember ${1:encoded} as jsonEncode(${2:value})",
            "remember ${3:decoded} as jsonDecode(${1:encoded})"
        ],
        "description": "JSON encode and decode"
    }
}
