{
    "name": "plain-language",
    "displayName": "Plain Language",
    "description": "Syntax highlighting and language support for the Plain programming language (.pln files)",
    "version": "2.1.1",
    "publisher": "ayoxx",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "plain",
                "aliases": ["Plain", "plain"],
                "extensions": [".pln"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/plain-file.svg",
                    "dark": "./icons/plain-file.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "plain",
                "scopeName": "source.plain",
                "path": "./syntaxes/plain.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "plain",
                "path": "./snippets/plain.code-snippets"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "echo 'No build step required'"
    },
    "license": "MIT"
}

