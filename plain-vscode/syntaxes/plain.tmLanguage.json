{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Plain",
    "scopeName": "source.plain",
    "fileTypes": [".pln"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#template-strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#function-names" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.plain",
                    "match": "//.*$"
                },
                {
                    "name": "comment.line.note.plain",
                    "match": "^\\s*note\\s*:.*$"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.plain",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.plain",
                    "match": "\\\\."
                },
                {
                    "name": "meta.embedded.line.plain",
                    "match": "\\$\\{[^}]*\\}"
                }
            ]
        },
        "template-strings": {
            "name": "string.template.plain",
            "begin": "`",
            "end": "`",
            "patterns": [
                {
                    "name": "constant.character.escape.plain",
                    "match": "\\\\."
                },
                {
                    "name": "meta.embedded.line.plain",
                    "match": "\\$\\{[^}]*\\}"
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.plain",
            "match": "\\b-?\\d+(\\.\\d+)?\\b"
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.plain",
                    "match": "\\b(if|otherwise|done|for|each|every|in|while|when|listen|javascript)\\b"
                },
                {
                    "name": "keyword.declaration.plain",
                    "match": "\\b(remember|make|use|import)\\b"
                },
                {
                    "name": "keyword.operator.plain",
                    "match": "\\b(becomes|as|give|show|reply|serve|note|print)\\b"
                },
                {
                    "name": "keyword.operator.comparison.plain",
                    "match": "\\b(is|greater|less|than|to|above|below|at|least|most|not|empty|contains|starts|ends|with|between|and)\\b"
                },
                {
                    "name": "keyword.other.web.plain",
                    "match": "\\b(web|app|route|start)\\b"
                },
                {
                    "name": "keyword.other.database.plain",
                    "match": "\\b(database|query|insert|update|delete|execute)\\b"
                },
                {
                    "name": "keyword.other.plain",
                    "match": "\\b(someone|visits|sends|clicks|matching|on|folder|json)\\b"
                },
                {
                    "name": "support.function.stdlib.plain",
                    "match": "\\b(uppercase|lowercase|random|round|readFile|writeFile|fileExists|sleep|time|date|jsonEncode|jsonDecode|env|exit|uuid|bot|sendMessage|sendPhoto|getChat|getMyChats|editMessage)(?=\\s*\\()"
                },
                {
                    "name": "constant.language.plain",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.plain",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.arithmetic.plain",
                    "match": "[+]"
                },
                {
                    "name": "punctuation.accessor.plain",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.comma.plain",
                    "match": ","
                },
                {
                    "name": "punctuation.section.braces.plain",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.separator.key-value.plain",
                    "match": ":"
                }
            ]
        },
        "function-names": {
            "patterns": [
                {
                    "comment": "Function declaration: make name(...)",
                    "match": "(?<=\\bmake\\s+)(\\w+)(?=\\s*\\()",
                    "name": "entity.name.function.plain"
                },
                {
                    "comment": "Function call: name(...)",
                    "match": "\\b(\\w+)(?=\\s*\\()",
                    "name": "entity.name.function.call.plain"
                }
            ]
        },
        "identifiers": {
            "name": "variable.other.plain",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
    }
}
