// PlainScript v1.0.2 — String and number helpers

show uppercase("hello")          // HELLO
show lowercase("WORLD")          // world
show length("PlainScript")       // 12
show trim("  spaced  ")          // spaced
show replace("a-b-c", "-", " ")  // a b c
show split("a,b,c", ",")         // [ 'a', 'b', 'c' ] (an array)
show join(list with "a", "b", "c", "-")  // a-b-c

remember price as number("42.5")
show price + 0.5                 // 43
show text(price)                 // 42.5 (back to text)

show floor(3.9)                  // 3
show ceiling(3.1)                // 4
show round(3.7)                  // 4

show "PlainScript" starts as "Plain"
show "PlainScript" ends as "Script"
show truncate("A very long sentence", 7) // A very…

remember id as "7"
show padStart(id, 3, "0")        // 007
