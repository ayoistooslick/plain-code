// PlainScript v1.0.02 — Reflection, hashing and tokens

remember user as
    name is "Ada"
    age is 17
done

show typeOf(user)           // record
show typeOf("hi")           // text
show typeOf(42)             // number
show typeOf([1, 2])         // array

show fieldsOf(user)         // [ 'name', 'age' ]
show sizeOf(user)           // 2
show hasField(user, "name") // true
show valueOf(user, "age", 0) // 17
show valueOf(user, "missing", "fallback")

// Hashing
show sha256("password")     // hex digest (64 chars)
show sha1("password")
show md5("password")

// Tokens
remember stored as hashPassword("s3cret")
show checkPassword("s3cret", stored)      // true
show checkPassword("wrong", stored)       // false

remember token as createToken({ sub: "user-1" }, "secret-key", 3600)
remember claims as readToken(token, "secret-key")
show sub of claims