// PlainScript v1.1.0 — PlainScript Expressions

remember players as list with "Haaland", "Foden", "Rodri"

show first player from players
show last player from players
show player three from players

add("Palmer" to players)
show players length

remove("Foden" from players)
show players length

remember user as
    name is "Ayokunle"
    age is 17
done

show name of user
name of user becomes "Ayo"

write("Saved by PlainScript Expressions" to "notes.txt")
show read("notes.txt")
