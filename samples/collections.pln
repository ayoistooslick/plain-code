// PlainScript v1.0.2 — Collection helpers

remember scores as list with 90, 55, 70, 55, 30

show sort(scores)          // [ 30, 55, 55, 70, 90 ]
show reverse(scores)       // [ 30, 55, 70, 55, 90 ]
show unique(scores)        // [ 90, 55, 70, 30 ]
show sum(scores)           // 300
show smallest(scores)      // 30
show largest(scores)       // 90
show length(scores)        // 5
show first(scores)         // 90
show last(scores)          // 30

remember user as
    name is "Ada"
    age is 17
done

show keys(user)            // [ 'name', 'age' ]
show values(user)          // [ 'Ada', 17 ]
show hasKey(user, "age")   // true
show hasKey(user, "city")  // false

remember joined as merge(user, record with country "Nigeria" done)
show country of joined

remember numbers as range(1, 6)     // [ 1, 2, 3, 4, 5 ]
show sum(numbers)

remember nested as list with list with 1, 2, list with 3, list with 4
show flatten(nested)                 // [ 1, 2, 3, 4 ]

remember crew as list with
    record with name "Ada" team "red" done,
    record with name "Bo" team "blue" done,
    record with name "Cy" team "red" done

show groupBy(crew, "team")
show pick(user, "name")
show omit(user, "age")
