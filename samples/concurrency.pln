// PlainScript v1.0.2 — Concurrency combinators

make slow()
    sleep(200)
    give "slow result"
done

make fast()
    sleep(50)
    give "fast result"
done

make maybeFails()
    give jsonDecode("not json")
done

remember both as all of list with slow(), fast()
show both at position 0
show both at position 1

remember winner as any of list with slow(), fast()
show winner

remember outcomes as settled of list with slow(), maybeFails()
for each result in outcomes
    show status of result
    if hasField(result, "value") is true
        show value of result
    otherwise
        show reason of result
    done
done

remember timed as withTimeout(fast(), 1000)
show timed
