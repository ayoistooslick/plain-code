// PlainScript v1.0.02 — Concurrency combinators

make slow()
    sleep(200)
    give "slow result"
done

make fast()
    sleep(50)
    give "fast result"
done

make maybeFails()
    give jsonDecode("not json")
done

remember both as all of [slow(), fast()]
show both[0]
show both[1]

remember winner as any of [slow(), fast()]
show winner

remember outcomes as settled of [slow(), maybeFails()]
for each result in outcomes
    show status of result
    if hasField(result, "value") is true
        show value of result
    otherwise
        show reason of result
    done
done

remember timed as withTimeout(fast(), 1000)
show timed