// PlainScript v1.0.1 — Filesystem and configuration helpers

writeFile("sample-notes.txt", "Hello from PlainScript files")
show readFile("sample-notes.txt")
show fileExists("sample-notes.txt")

appendFile("sample-notes.txt", " More content.")
show readFile("sample-notes.txt")

makeFolder("sample-folder")
writeFile("sample-folder/inside.txt", "nested")
show listFolder("sample-folder")

show fileSize("sample-notes.txt")
show fileType("sample-notes.txt")          // file
show baseName("sample-folder/inside.txt")  // inside.txt
show extensionOf("sample-folder/inside.txt") // .txt

copyFile("sample-notes.txt", "sample-notes-copy.txt")
show fileExists("sample-notes-copy.txt")

deleteFile("sample-notes-copy.txt")
deleteFolder("sample-folder")

// YAML subset
remember config as yamlDecode("name: PlainScript\nversion: 1.0.1\n")
show name of config
show version of config

// Binary round-trip
show base64Encode("hello")
show base64Decode("aGVsbG8=")
show sha256("hello")

load env file ".env"
show env("EXAMPLE_TOKEN")