{
  "name": "telegram",
  "category": "bots",
  "version": 2,
  "title": "Telegram Bot",
  "purpose": "Telegram bot creation, polling, commands, replies, buttons, callback queries, and messaging.",
  "keywords": [
    "telegram",
    "bot",
    "message",
    "command",
    "callback",
    "reply",
    "button"
  ],
  "triggers": [
    { "type": "regex", "pattern": "\\btelegram\\s+bot\\s+with\\s+token\\b" },
    { "type": "regex", "pattern": "\\bwhen\\s+someone\\s+sends\\b" },
    { "type": "regex", "pattern": "\\bwhen\\s+someone\\s+clicks\\b" },
    { "type": "regex", "pattern": "\\bsendMessage\\s+\\w+" },
    { "type": "regex", "pattern": "\\bsendPhoto\\s+\\w+" },
    { "type": "regex", "pattern": "\\beditMessage\\s+\\w+" },
    { "type": "regex", "pattern": "\\bstart\\s+telegram\\s+bot\\b" }
  ],
  "dependencies": ["node-telegram-bot-api"],
  "imports": [],
  "async": true,
  "compilerMin": "2.0.0",
  "resolvablePaths": ["bots/telegram", "bots/telegram.json"]
}
