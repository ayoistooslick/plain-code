{
  "name": "fetch",
  "category": "http",
  "version": 2,
  "title": "HTTP Fetch",
  "purpose": "HTTP requests (GET/POST/PUT/PATCH/DELETE) with headers, JSON bodies, JSON responses, status checks, and error handling via fetch.",
  "keywords": [
    "http",
    "fetch",
    "request",
    "response",
    "headers",
    "json",
    "api",
    "status"
  ],
  "triggers": [
    { "type": "regex", "pattern": "\\bawait\\s+fetch\\b" },
    { "type": "regex", "pattern": "\\bremember\\s+\\w+\\s+as\\s+(?:await\\s+)?fetch\\b" },
    { "type": "regex", "pattern": "\\bresponse\\s+is\\s+ok\\b" },
    { "type": "regex", "pattern": "\\bresponse\\s+is\\s+not\\s+ok\\b" },
    { "type": "regex", "pattern": "\\bwith\\s+method\\s+\"\\w+\"\\b" }
  ],
  "dependencies": [],
  "imports": [],
  "async": true,
  "compilerMin": "2.0.0",
  "resolvablePaths": ["http/fetch", "http/fetch.json"]
}
