// PlainScript v1.0.0-latest — Record kinds, generators and the test DSL
//
// Run with:  plainscript run examples/record-kinds.ps
//
// Defines a schema, builds instances, composes records, streams values from
// generators, and verifies behaviour with the built-in test runner.

define a kind called "Book" with
    title is ""
    pages is 0
    rating is 0
done

remember fav as create a Book with title "IOPL in Action" and pages 240
fav.rating becomes 4.5

show title of fav
show pages of fav
show rating of fav

remember extended as merge(fav, { author: "Ada" })
show author of extended
show fieldsOf(extended)

test "book schema"
    check title of fav equals "IOPL in Action"
    check rating of fav equals 4.5
    check hasField(fav, "author") equals false
done

test "generator"
    remember ids as spread of range(1, 4)
    check length(ids) equals 3
    check sum(ids) equals 6
done

make makeTitles(catalog)
    for each book in catalog
        yield title of book
    done
done

show spread of makeTitles([fav, extended])