// REST API with HTTP fetch — multi-source integration example
//
// This example demonstrates a REST API that fetches data from multiple
// upstream APIs and combines the results. It uses the deterministic compiler
// for the Express server and the Complex Compilation layer for HTTP fetch
// and REST API rules.

use express

remember app as express()

// Health check
app get "/health" as
  reply { "status": "ok", "version": "2.0" }
done

// Fetch random user from randomuser.me API
app get "/api/random-user" as
  remember response as await fetch "https://randomuser.me/api/"
  if response is ok
    remember data as await response.json()
    reply data
  otherwise
    reply status 500 with { "error": "Failed to fetch user" }
  done
done

// Fetch multiple APIs and combine results
app get "/api/dashboard" as
  remember userRes as await fetch "https://randomuser.me/api/"
  remember jokeRes as await fetch "https://official-joke-api.appspot.com/random_joke"

  remember user as null
  remember joke as null

  if userRes is ok
    remember userData as await userRes.json()
    user = userData.results[0]
  done

  if jokeRes is ok
    joke = await jokeRes.json()
  done

  reply { "user": user, "joke": joke }
done

// Search with query parameters
app get "/api/search" as
  remember q as request.query("q")
  remember limit as request.query("limit")
  reply { "query": q, "limit": limit, "results": [] }
done

// Create a resource
app post "/api/items" as
  remember body as request.json
  reply { "created": true, "item": body }
done

// Update a resource
app put "/api/items/:id" as
  remember id as request.param("id")
  remember body as request.json
  reply { "updated": id, "item": body }
done

// Delete a resource
app delete "/api/items/:id" as
  remember id as request.param("id")
  reply { "deleted": id }
done

// Error handling middleware
app use error as
  reply status 500 with { "error": error.message }
done

listen app on port 3000
    show "Server running at http://localhost:3000"
done
