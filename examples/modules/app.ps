// PlainScript v1.0.0-latest — Importing your own modules
//
// Run with:  plainscript run examples/modules/app.ps
//
// Files are compiled in dependency order (deepest first), so the helpers in
// math.ps are visible here before app.ps runs.

import "./math.ps"

show PI                     // 3.14
show double(21)             // 42
show square(9)              // 81
show circumference(10)      // 62.8

remember radius as 2.5
show "circle area: " + text(square(radius) * PI)