// PLINJS v2.1 — Sending email
//
// Run with:  MAIL_PASS=secret plinjs run examples/email-send.pln
//
// Configure the outgoing transport once, then send as many mails as you
// like. Credentials come from the environment — never hardcode them.

mail transport
    host is "smtp.gmail.com"
    port is 587
    user is env("EMAIL_USER")
    pass is env("EMAIL_PASS")
done

send mail
    from is "hello@plinjs.dev"
    to is "you@example.com"
    subject is "Hello from PLINJS"
    text is "This email was sent from a PLINJS program."
done

show "Email sent successfully"
