// PlainScript v1.0.0-latest — Sessions, cookies and rate limiting
//
// Run with:  plainscript run examples/sessions-and-cookies.ps
// Then try:
//   curl -c cookies.txt -b cookies.txt http://localhost:3000/login
//   curl -c cookies.txt -b cookies.txt http://localhost:3000/profile
//   curl -c cookies.txt -b cookies.txt http://localhost:3000/logout
//
// The app shows login/logout flow backed by signed sessions, preference
// cookies, and a per-IP rate limit.

web app

limit requests to 100 per minute
enable sessions "a-long-random-secret-minimum"

allow cors

route get "/login"
    user of session of request becomes "ada"
    set cookie "theme" to "dark" expires in 7 days
    reply json
        welcome is true
        who is user of session of request
    done
done

route get "/profile"
    remember who as user of session of request
    if who is empty
        status 401
        reply "Please log in first via /login"
    otherwise
        reply json
            user is who
            theme is cookie("theme")
        done
    done
done

route post "/logout"
    destroy session
    clear cookie "theme"
    reply "Logged out. Goodbye!"
done

when nothing matches
    status 404
    reply json
        error is "no such road"
    done
done

start 3000