// PlainScript v2.1 — Cache, background jobs and cron working together
//
// Run with:  REDIS_URL=redis://localhost:6379 plainscript run examples/cache-and-jobs.ps
//
// Heavy work is pushed off the request path with "run background", shared
// state lives in Redis, and a cron job refreshes it every minute.

cache env("REDIS_URL")

make generateReport()
    show "Generating report…"
    give "report-data-" + date()
done

// Refresh the cached report every minute
schedule "* * * * *"
    run background cacheSet("report", generateReport())
done

remember report as cacheGet("report")
if report is empty
    show "No report yet — generating one now"
    remember fresh as generateReport()
    cacheSet("report", fresh, 3600)
otherwise
    show "Cached report: " + report
done

show "Cache demo running"
