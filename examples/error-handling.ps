// PlainScript v1.0.0-latest — Robust error handling
//
// Run with:  plainscript run examples/error-handling.ps
//
// Shows deterministic recovery: typed "recover" blocks, silent swallowing,
// and automatic retries with backoff for flaky operations.

make parseSettings(raw)
    remember settings as jsonDecode(raw)
    if settings is empty
        give { theme: "light" }
    otherwise
        give settings
    done
done

// Recover with the thrown value
try
    remember settings as parseSettings("{ bad json")
    show theme of settings
recover as err
    show "falling back: " + message of err
    remember settings as { theme: "dark" }
    show theme of settings
done

// Multiple typed recover clauses win on error name
try
    remember parsed as jsonDecode("also not json")
recover when err catches "SyntaxError"
    show "JSON parse error caught: " + message of err
recover as err
    show "some other error: " + message of err
done

// Swallow failures silently when no recover is present
try
    remember probe as read("does-not-exist.txt")
done
show "survived the failed read"

// Automatic retry with a delay
remember logs as []
make fetchStatus()
    add("trying…" to logs)
    give read("status.db.json")
done

retry 3 times every 1 second
    remember body as fetchStatus()
    show body
done

show length(logs)