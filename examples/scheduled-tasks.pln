// PlainScript v2.1 — Scheduled and recurring tasks
//
// Run with:  plainscript run examples/scheduled-tasks.pln
//
// "every" covers simple intervals; "schedule" accepts any standard cron
// expression (powered by croner).

// A heartbeat every 30 seconds
every 30 seconds
    show "Heartbeat: " + now()
done

// Any standard cron expression
schedule "*/5 * * * *"
    show "Five minutes have passed"
done

// Nightly cleanup at 2 AM
schedule "0 2 * * *"
    show "Running the nightly cleanup"
done

show "Scheduled tasks registered — press Ctrl+C to stop"
