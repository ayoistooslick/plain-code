// idverify · src/verify.pln
// The verification workflow: take a document record, fingerprint it, and
// return a deterministic verification result.

import "./hash.pln"

make verifyDocument(fields)
    remember result as
        holder is fields.holder
        documentType is fields.documentType
        number is fields.number
        ok is true
        fingerprint is fingerprint(fields)
        verifiedAt is time()
    done
    give result
done

export verifyDocument
