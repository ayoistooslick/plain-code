// PlainScript 1.0.3-beta: hardcoded Telegram support bot.

bot env("TELEGRAM_BOT_TOKEN")

when someone sends "/start"
    reply "Welcome. Choose /hours, /pricing, or /contact."
done

when someone sends "/hours"
    reply "Support is available Monday to Friday, 09:00 to 17:00 UTC."
done

when someone sends "/pricing"
    reply "Plans start at $10 per month. Ask /contact for a person."
done

when someone sends "/contact"
    reply "Please send your email and a support specialist will reply."
done

when someone sends matching "/echo (.+)"
    reply text
done

when someone sends "/menu"
    reply "Choose a topic" with buttons
        "Hours" -> "hours"
        "Pricing" -> "pricing"
        "Contact" -> "contact"
    done
done

when someone clicks "hours"
    reply "Support is available Monday to Friday, 09:00 to 17:00 UTC."
done

when someone clicks "pricing"
    reply "Plans start at $10 per month."
done

when someone clicks "contact"
    reply "Please send your email and a support specialist will reply."
done

start telegram bot