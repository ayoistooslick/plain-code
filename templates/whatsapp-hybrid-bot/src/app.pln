// PlainScript 1.0.35: a WhatsApp + Telegram hybrid support bot.
//
// One runtime hosts both channels:
//  - WhatsApp: pairing login, full message-type detection, media download,
//    and a command menu.
//  - Telegram: command handlers and an inline button menu.
//
// The default Baileys package is the qwerty fork (@qwerty-xcv/baileys). To pin
// a different implementation, add a line inside the whatsapp block:
//
//   use baileys "@whiskeysockets/baileys"

bot env("TELEGRAM_BOT_TOKEN")

// ── WhatsApp channel ─────────────────────────────────────────────────────────
// Set WHATSAPP_PHONE to the full international number (digits only, no "+").
whatsapp bot
    auth "whatsapp-session"
    login pairing env("WHATSAPP_PHONE")

    on message
        if message.type is "text"
            if message.text is "/start"
                reply "Welcome to the hybrid bot. Try /menu or send a photo."
            done

            if message.text is "/menu"
                reply "Choose a topic" with buttons
                    "Hours" -> "hours"
                    "Pricing" -> "pricing"
                    "Human" -> "human"
                done
            done

            if message.text is "/default"
                reply "I'm online on both WhatsApp and Telegram."
            done
        done

        // Media handling: save any image the customer sends.
        if message.type is "image"
            download "downloads/whatsapp-photo.jpg"
            reply "Got your picture. We saved it for the team."
        done

        if message.type is "button"
            reply "You chose: " + message.buttonId
        done

        if message.type is "document"
            download "downloads/whatsapp-document"
            reply "We received your document."
        done
    done
done

// ── Telegram channel ─────────────────────────────────────────────────────────
when someone sends "/start"
    reply "Welcome to the hybrid bot. Use /menu for options."
done

when someone sends "/menu"
    reply "Choose an option" with buttons
        "Hours" -> "hours"
        "Pricing" -> "pricing"
        "Human" -> "human"
    done
done

when someone clicks "hours"
    reply "Support is available Monday to Friday, 09:00 to 17:00 UTC."
done

when someone clicks "pricing"
    reply "Plans start at $10 per month."
done

when someone clicks "human"
    reply "A specialist will message you shortly."
done

start telegram bot
