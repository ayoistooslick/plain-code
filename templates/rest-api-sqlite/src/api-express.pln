// rest-api-sqlite · src/api-express.pln
// Full CRUD REST API with SQLite using classic Express style
// This version works at runtime but has a compiler bug where the
// top-level execute block includes the entire program in db.exec.
// Workaround: Run the CREATE TABLE manually or use a separate init script.

database "data.db"

execute
    CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        email TEXT NOT NULL UNIQUE,
        created_at TEXT NOT NULL DEFAULT (datetime('now'))
    )
end

use express

let app is express()

allow cors
limit requests to 60 per minute
require api key from env("API_KEY")

when someone visits "/health"
    print jsonEncode(record with
        status "ok"
        timestamp date()
        uptime time()
    done)
end

when someone visits "/api/users"
    let rows is query
        SELECT id, name, email, created_at FROM users ORDER BY created_at DESC
    end
    print jsonEncode(record with
        status "ok"
        data rows
        count length of rows
    done)
end

when someone visits "/api/users" method "POST"
    let body is body of request
    let missing is validate(body, list with "name", "email")
    if length of missing more than 0
        status 400
        print jsonEncode(record with
            status "error"
            message "Missing required fields"
            missing missing
        done)
    end
    let createdAt is date()
    insert
        INSERT INTO users (name, email, created_at) VALUES ({body.name}, {body.email}, {createdAt})
    end
    let newUser is query
        SELECT id, name, email, created_at FROM users WHERE id = last_insert_rowid()
    end
    status 201
    print jsonEncode(record with
        status "ok"
        data first newUser from newUser
        message "User created successfully"
    done)
end

when someone visits "/api/users/:id"
    let id is param("id")
    let user is query
        SELECT id, name, email, created_at FROM users WHERE id = {id}
    end
    if length of user same as 0
        status 404
        print jsonEncode(record with
            status "error"
            message "User not found"
        done)
    end
    if length of user more than 0
        print jsonEncode(record with
            status "ok"
            data first user from user
        done)
    end
end

when someone visits "/api/users/:id" method "PUT"
    let id is param("id")
    let body is body of request
    let missing is validate(body, list with "name", "email")
    if length of missing more than 0
        status 400
        print jsonEncode(record with
            status "error"
            message "Missing required fields"
            missing missing
        done)
    end
    let existing is query
        SELECT id FROM users WHERE id = {id}
    end
    if length of existing same as 0
        status 404
        print jsonEncode(record with
            status "error"
            message "User not found"
        done)
    end
    execute
        UPDATE users SET name = {body.name}, email = {body.email} WHERE id = {id}
    end
    let updated is query
        SELECT id, name, email, created_at FROM users WHERE id = {id}
    end
    print jsonEncode(record with
        status "ok"
        data first updated from updated
        message "User updated successfully"
    done)
end

when someone visits "/api/users/:id" method "DELETE"
    let id is param("id")
    let existing is query
        SELECT id FROM users WHERE id = {id}
    end
    if length of existing same as 0
        status 404
        print jsonEncode(record with
            status "error"
            message "User not found"
        done)
    end
    execute
        DELETE FROM users WHERE id = {id}
    end
    print jsonEncode(record with
        status "ok"
        message "User deleted successfully"
    done)
end

listen on env("PORT") or 3000
    print "Server running on port " + (env("PORT") or "3000")
end