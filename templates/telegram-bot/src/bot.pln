// telegram-bot · src/bot.pln
// A complete Telegram bot template with hardcoded replies for commands
// and inline keyboard callbacks. Uses bot env("BOT_TOKEN") for config.

bot env("BOT_TOKEN")

// /start — welcome message with an inline keyboard
when someone sends "/start"
    reply "Welcome to the PlainScript Telegram Bot! 🤖\n\nChoose an option below:" with buttons
        "Help" -> "help"
        "About" -> "about"
        "Status" -> "status"
        "Echo Test" -> "echo_demo"
    done
done

// /help — list available commands
when someone sends "/help"
    reply "Available commands:\n/start - Show main menu\n/help - Show this help\n/about - About this bot\n/status - Bot status\n/echo <text> - Echo back text\n/time - Current server time"
done

// /about — about the bot
when someone sends "/about"
    reply "PlainScript Telegram Bot Template\n\nBuilt with PlainScript - an Intent-Oriented Programming Language.\n\nThis template demonstrates:\n• Command handlers (/start, /help, /about, /status, /echo, /time)\n• Inline keyboard callbacks\n• Hardcoded replies\n• Environment variable token loading\n\nSource: github.com/anomalyco/plainscript"
done

// /status — bot status
when someone sends "/status"
    remember currentTime as date()
    reply "✅ Bot is running\n🕐 Server time: " + currentTime + "\n📡 Long polling active"
done

// /echo — echo back user text
when someone sends matching "^/echo (.+)"
    reply "Echo: " + ctx.matches[1]
done

// /time — current server time
when someone sends "/time"
    remember currentTime2 as date()
    reply "🕐 Current server time: " + currentTime2
done

// Callback handlers for inline keyboard buttons
when someone clicks "help"
    reply "📖 Help Menu\n\nThis bot responds to the following commands:\n/start - Show main menu with buttons\n/help - List all commands\n/about - About this bot\n/status - Check bot status\n/echo <text> - Echo your text\n/time - Show current time\n\nTry clicking the buttons below or type a command!" with buttons
        "Back to Menu" -> "start"
    done
done

when someone clicks "about"
    reply "ℹ️ About This Bot\n\nThis is a PlainScript Telegram bot template.\n\nPlainScript is an Intent-Oriented Programming Language that compiles to JavaScript.\n\nFeatures demonstrated:\n• Command routing\n• Inline keyboards\n• Callback queries\n• Environment config\n• Date/time functions\n\nRepository: github.com/anomalyco/plainscript" with buttons
        "Back to Menu" -> "start"
    done
done

when someone clicks "status"
    remember currentTime3 as date()
    reply "📊 Bot Status\n\n✅ Status: Online\n🕐 Checked at: " + currentTime3 + "\n🔄 Polling: Active\n💾 Memory: Normal\n\nAll systems operational." with buttons
        "Refresh" -> "status"
        "Back to Menu" -> "start"
    done
done

when someone clicks "echo_demo"
    reply "🔁 Echo Demo\n\nTry sending: /echo Hello World\n\nThe bot will reply with your text.\n\nExample:\nYou: /echo Hello PlainScript\nBot: Echo: Hello PlainScript" with buttons
        "Back to Menu" -> "start"
    done
done

when someone clicks "start"
    reply "Welcome back! 🤖\n\nChoose an option below:" with buttons
        "Help" -> "help"
        "About" -> "about"
        "Status" -> "status"
        "Echo Test" -> "echo_demo"
    done
done

// Fallback for unhandled messages
when someone sends matching "."
    reply "I didn't understand that. Type /help for available commands or /start for the menu."
done

// Boot long polling
start telegram bot