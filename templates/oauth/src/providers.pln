// oauth · src/providers.pln
// A provider registry for the unified OAuth system. Each provider is a plain
// record describing its authorization/token endpoints and scopes.

make googleConfig()
    remember cfg as
        name is "google"
        authorizeUrl is "https://accounts.google.com/o/oauth2/v2/auth"
        tokenUrl is "https://oauth2.googleapis.com/token"
        scopes is "openid email profile"
    done
    give cfg
done

make githubConfig()
    remember cfg as
        name is "github"
        authorizeUrl is "https://github.com/login/oauth/authorize"
        tokenUrl is "https://github.com/login/oauth/access_token"
        scopes is "read:user user:email"
    done
    give cfg
done

make providerConfig(name)
    if name is "google"
        give googleConfig()
    done
    if name is "github"
        give githubConfig()
    done
    throw "unknown provider: " + name
done

export googleConfig
export githubConfig
export providerConfig
