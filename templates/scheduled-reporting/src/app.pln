// PlainScript 1.0.2-latest: scheduled report with a status endpoint.

remember latest as "No report has run yet"

make createReport()
    latest becomes `report created at ${date()}`
    writeFile("latest-report.txt", latest)
    give latest
done

schedule "0 * * * *"
    createReport()
done

web app
route get "/reports/latest"
    reply json
        report is latest
    done
done

start 3000