{
    "Let variable": {
        "prefix": "let",
        "body": ["let ${1:name} is ${2:value}"],
        "description": "Declare a variable"
    },
    "Reassign variable": {
        "prefix": "reassign",
        "body": ["${1:name} is now ${2:value}"],
        "description": "Reassign a variable"
    },
    "Print value": {
        "prefix": "print",
        "body": ["print ${1:value}"],
        "description": "Print a value"
    },
    "If statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition}",
            "    print ${2:\"yes\"}",
            "end"
        ],
        "description": "If block"
    },
    "If / otherwise": {
        "prefix": "ifo",
        "body": [
            "if ${1:condition}",
            "    print ${2:\"yes\"}",
            "otherwise",
            "    print ${3:\"no\"}",
            "end"
        ],
        "description": "If / otherwise block"
    },
    "Define function": {
        "prefix": "def",
        "body": [
            "define ${1:name}(${2:params})",
            "    ${3:print \"hello\"}",
            "end"
        ],
        "description": "Define a function"
    },
    "Define function with return": {
        "prefix": "defg",
        "body": [
            "define ${1:name}(${2:a}, ${3:b})",
            "    give back ${4:a + b}",
            "end"
        ],
        "description": "Define a function with a return value"
    },
    "For each loop": {
        "prefix": "foreach",
        "body": [
            "for each ${1:item} in ${2:collection}",
            "    print ${1:item}",
            "end"
        ],
        "description": "For each loop"
    },
    "While loop": {
        "prefix": "while",
        "body": [
            "while ${1:x} is less than ${2:10}",
            "    ${3:x is now x + 1}",
            "end"
        ],
        "description": "While loop"
    },
    "Array literal": {
        "prefix": "arr",
        "body": [
            "let ${1:items} is [",
            "    ${2:\"item1\"},",
            "    ${3:\"item2\"}",
            "]"
        ],
        "description": "Declare an array"
    },
    "Object literal": {
        "prefix": "obj",
        "body": [
            "let ${1:obj} is",
            "    ${2:key} is ${3:\"value\"}",
            "end"
        ],
        "description": "Declare an object"
    },
    "Web app": {
        "prefix": "webapp",
        "body": [
            "web app",
            "",
            "route \"/\"",
            "    print \"${1:Hello from PlainScript!}\"",
            "end",
            "",
            "start ${2:3000}"
        ],
        "description": "Web app boilerplate"
    },
    "Route": {
        "prefix": "route",
        "body": [
            "route \"${1:/path}\"",
            "    print ${2:\"Hello\"}",
            "end"
        ],
        "description": "Define a route"
    },
    "Express app": {
        "prefix": "express",
        "body": [
            "use express",
            "",
            "let app is express()",
            "",
            "when someone visits \"${1:/}\"",
            "    print \"${2:Hello from PlainScript!}\"",
            "end",
            "",
            "listen on ${3:3000}",
            "    print \"Server running on port ${3:3000}\"",
            "end"
        ],
        "description": "Classic Express app boilerplate"
    },
    "Database": {
        "prefix": "database",
        "body": [
            "database \"${1:app.db}\"",
            "",
            "execute",
            "    CREATE TABLE IF NOT EXISTS ${2:items} (id INTEGER PRIMARY KEY, ${3:name} TEXT)",
            "end"
        ],
        "description": "SQLite database setup"
    },
    "Query": {
        "prefix": "query",
        "body": [
            "query",
            "    SELECT * FROM ${1:table}",
            "end"
        ],
        "description": "SQL query block"
    },
    "Between comparison": {
        "prefix": "between",
        "body": ["if ${1:x} between ${2:1} and ${3:10}"],
        "description": "Between comparison"
    },
    "Contains check": {
        "prefix": "contains",
        "body": ["if ${1:text} contains ${2:\"word\"}"],
        "description": "String contains check"
    },
    "Try / recover": {
        "prefix": "try",
        "body": [
            "try",
            "    ${1:print \"risky operation\"}",
            "recover as err",
            "    print \"Error: \" + message of err",
            "end"
        ],
        "description": "Try / recover error handling"
    },
    "JSON encode/decode": {
        "prefix": "json",
        "body": [
            "let ${1:encoded} is jsonEncode(${2:value})",
            "let ${2:decoded} is jsonDecode(${1:encoded})"
        ],
        "description": "JSON encode and decode"
    },
    "Record kind": {
        "prefix": "kind",
        "body": [
            "define a kind called \"${1:Person}\" with",
            "    ${2:name} is ${3:\"\"}",
            "end",
            "",
            "let ${4:instance} is create a ${1:Person} with ${2:name} \"${5:Alice}\""
        ],
        "description": "Define a record kind (class)"
    },
    "Test block": {
        "prefix": "test",
        "body": [
            "test \"${1:my test}\"",
            "    check ${2:add(2, 3)} equals ${3:5}",
            "end"
        ],
        "description": "Native test block"
    },
    "Wait for": {
        "prefix": "waitfor",
        "body": ["let ${1:result} is wait for ${2:promise}"],
        "description": "Await a promise"
    },
    "At position": {
        "prefix": "atpos",
        "body": ["${1:name} at position ${2:0}"],
        "description": "Access value at position"
    },
    "Has field": {
        "prefix": "hasfield",
        "body": ["${1:name} has field \"${2:field}\""],
        "description": "Check if a value has a field"
    },
    "Made of": {
        "prefix": "madeof",
        "body": ["${1:name} made of \"${2:text}\""],
        "description": "Create a value made of text"
    },
    "More than": {
        "prefix": "morethan",
        "body": ["${1:a} more than ${2:b}"],
        "description": "Greater-than comparison"
    },
    "Fewer than": {
        "prefix": "fewerthan",
        "body": ["${1:a} fewer than ${2:b}"],
        "description": "Less-than comparison"
    },
    "Same as": {
        "prefix": "sameas",
        "body": ["${1:a} same as ${2:b}"],
        "description": "Equality comparison"
    },
    "Different from": {
        "prefix": "difffrom",
        "body": ["${1:a} different from ${2:b}"],
        "description": "Inequality comparison"
    },
    "Raise": {
        "prefix": "raises",
        "body": ["raise ${1:expr}"],
        "description": "Raise an error"
    },
    "Choosing": {
        "prefix": "choosing",
        "body": [
            "choosing ${1:cond} then ${2:a} otherwise ${3:b}"
        ],
        "description": "Conditional expression"
    },
    "Fill with": {
        "prefix": "fillwith",
        "body": ["fill ${1:name} with ${2:args} together"],
        "description": "Fill a value with arguments"
    }
}
