{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["\"", "\""],
    ["`", "`"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["`", "`"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|otherwise|make|define|function|for|while|when|route|web|database|query|insert|update|delete|execute|try|recover|finally|test|match|switch|websocket|bot|whatsapp)\\b.*$",
    "decreaseIndentPattern": "^\\s*(done|otherwise|finally|recover)\\b.*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(if|make|define|function|for|while|when|route|web|try|test|match|switch|websocket|bot|whatsapp)\\b",
      "end": "^\\s*done\\b"
    }
  }
}