{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "PlainScript",
    "scopeName": "source.plainscript",
    "fileTypes": [".ps"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#template-strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#function-names" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.plainscript",
                    "match": "//.*$"
                },
                {
                    "name": "comment.line.note.plainscript",
                    "match": "^\\s*note\\s*:.*$"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.plainscript",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.plainscript",
                    "match": "\\\\."
                },
                {
                    "name": "meta.embedded.line.plainscript",
                    "match": "\\$\\{[^}]*\\}"
                }
            ]
        },
        "template-strings": {
            "name": "string.template.plainscript",
            "begin": "`",
            "end": "`",
            "patterns": [
                {
                    "name": "constant.character.escape.plainscript",
                    "match": "\\\\."
                },
                {
                    "name": "meta.embedded.line.plainscript",
                    "match": "\\$\\{[^}]*\\}"
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.plainscript",
            "match": "\\b-?\\d+(\\.\\d+)?\\b"
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.plainscript",
                    "match": "\\b(if|otherwise|done|for|each|every|in|while|when|listen|javascript|ask|ocr|try|recover|retry|times|wait|enable|destroy|accept|require|using)\\b"
                },
                {
                    "name": "keyword.declaration.plainscript",
                    "match": "\\b(remember|make|use|import)\\b"
                },
                {
                    "name": "keyword.operator.plainscript",
                    "match": "\\b(becomes|as|give|show|reply|serve|note|print|broadcast)\\b"
                },
                {
                    "name": "keyword.operator.comparison.plainscript",
                    "match": "\\b(is|greater|less|than|to|above|below|at|least|most|not|empty|contains|starts|ends|with|between|and|or)\\b"
                },
                {
                    "name": "keyword.other.web.plainscript",
                    "match": "\\b(web|app|route|start|group|allow|cors|validate|status|param|nothing|matches)\\b"
                },
                {
                    "name": "keyword.other.database.plainscript",
                    "match": "\\b(database|query|insert|update|delete|execute)\\b"
                },
                {
                    "name": "keyword.other.backend.plainscript",
                    "match": "\\b(sessions|session|uploads|limit|requests|api|key|google|oauth|cookie|expires|native|wasm|postgres|schedule|background|websocket|socket|connects|disconnects|mail|transport|headers|timeout)\\b"
                },
                {
                    "name": "keyword.other.plainscript",
                    "match": "\\b(someone|visits|sends|clicks|matching|on|folder|json)\\b"
                },
                {
                    "name": "support.function.stdlib.plainscript",
                    "match": "\\b(length|uppercase|lowercase|trim|replace|split|join|number|text|floor|ceiling|random|round|sort|reverse|unique|sum|smallest|largest|keys|values|hasKey|merge|sqlite|print|readFile|writeFile|appendFile|fileExists|copyFile|moveFile|deleteFile|makeFolder|deleteFolder|listFolder|readBytes|writeBytes|read|write|sleep|time|date|jsonEncode|jsonDecode|env|exit|uuid|cacheGet|cacheSet|cacheDelete|hashPassword|checkPassword|createToken|readToken|validate|param|query|header|upload|uploads|cookie|bot|sendMessage|sendPhoto|getChat|getMyChats|editMessage)(?=\\s*\\()"
                },
                {
                    "name": "constant.language.plainscript",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.plainscript",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.arithmetic.plainscript",
                    "match": "[+\\-*/%]"
                },
                {
                    "name": "punctuation.accessor.plainscript",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.comma.plainscript",
                    "match": ","
                },
                {
                    "name": "punctuation.section.braces.plainscript",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.separator.key-value.plainscript",
                    "match": ":"
                }
            ]
        },
        "function-names": {
            "patterns": [
                {
                    "comment": "Function declaration: make name(...)",
                    "match": "(?<=\\bmake\\s+)(\\w+)(?=\\s*\\()",
                    "name": "entity.name.function.plainscript"
                },
                {
                    "comment": "Function call: name(...)",
                    "match": "\\b(\\w+)(?=\\s*\\()",
                    "name": "entity.name.function.call.plainscript"
                }
            ]
        },
        "identifiers": {
            "name": "variable.other.plainscript",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
    }
}
