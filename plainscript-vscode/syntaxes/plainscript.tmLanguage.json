{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PlainScript",
  "scopeName": "source.plainscript",
  "fileTypes": ["pln"],
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#operators"},
    {"include": "#functions"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {"name": "comment.line.double-slash.plainscript", "match": "//.*$"}
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.plainscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [{"name": "constant.character.escape.plainscript", "match": "\\\\."}]
        },
        {
          "name": "string.template.plainscript",
          "begin": "`",
          "end": "`",
          "patterns": [
            {"name": "constant.character.escape.plainscript", "match": "\\\\."},
            {"name": "meta.embedded.line.plainscript", "match": "\\$\\{[^}]*\\}"}
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.plainscript",
      "match": "\\b\\d+(\\.\\d+)?n?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.plainscript",
          "match": "\\b(if|otherwise|else|for|each|every|index|from|to|while|in|when|listen|route|web|start|done|try|recover|finally|retry|times|wait|accept|require|enable|limit|test|match|against|switch|case|default|break|continue|return|give|yield|on|with|and|or|not|between|contains|starts|ends|is|same|different|more|fewer|at|least|most|has|field|instanceof)\\b"
        },
        {
          "name": "keyword.declaration.plainscript",
          "match": "\\b(remember|let|make|define|function|use|import|export|database|postgres|create|record|list|websocket|bot|whatsapp|ocr)\\b"
        },
        {
          "name": "keyword.other.plainscript",
          "match": "\\b(show|print|display|give|becomes|is_now|set_to|change_to|reply|respond|serve|folder|json|query|insert|update|delete|execute|transaction|cache|schedule|background|socket|connects|disconnects|message|broadcast|send|upload|uploads|cookie|session|api|key|cors)\\b"
        },
        {
          "name": "constant.language.plainscript",
          "match": "\\b(true|false|null|undefined)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {"name": "keyword.operator.plainscript", "match": "\\?\\?|\\?\\.|\\*\\*|->|\\+|-|\\*|/|%|\\b(plus|minus|times|divided by)\\b"},
        {"name": "punctuation.separator.plainscript", "match": "[.,:()\\[\\]{}]"}
      ]
    },
    "functions": {
      "patterns": [
        {"name": "entity.name.function.plainscript", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"}
      ]
    }
  }
}