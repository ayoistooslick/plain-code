{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "PlainScript",
    "scopeName": "source.plainscript",
    "fileTypes": [".pln"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#template-strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#function-names" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.plainscript",
                    "match": "//.*$"
                },
                {
                    "name": "comment.line.note.plainscript",
                    "match": "^\\s*note\\s*:.*$"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.plainscript",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.plainscript",
                    "match": "\\\\."
                }
            ]
        },
        "template-strings": {
            "name": "string.template.plainscript",
            "begin": "`",
            "end": "`",
            "patterns": [
                {
                    "name": "constant.character.escape.plainscript",
                    "match": "\\\\."
                },
                {
                    "name": "meta.embedded.line.plainscript",
                    "match": "\\$\\{[^}]*\\}"
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.plainscript",
            "match": "\\b-?\\d+(\\.\\d+)?\\b"
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.plainscript",
                    "match": "\\b(if|otherwise|for|each|every|in|while|when|listen|try|recover|retry|times|wait|enable|destroy|accept|require|using|end|at|position|of|kind|has|field|starts|as|ends|made|uses|fills|raises|handled|choosing|then|more|fewer|same|different|from)\\b"
                },
                {
                    "name": "keyword.declaration.plainscript",
                    "match": "\\b(let|define|function|use|import|export|database|web|bot|whatsapp)\\b"
                },
                {
                    "name": "keyword.operator.assignment.plainscript",
                    "match": "\\b(is now|set to|change to|give back|return)\\b"
                },
                {
                    "name": "keyword.operator.plainscript",
                    "match": "\\b(as|give|reply|serve|note|print|broadcast|log|ask|ocr|send|load|run|test|check|spread|yield|merge|create|kind|called|at_position|of_kind|has_field|starts_as|ends_as|made_of|uses|fills|raises|handled_by|choosing|more_than|fewer_than|same_as|different_from)\\b"
                },
                {
                    "name": "keyword.operator.comparison.plainscript",
                    "match": "\\b(is|greater|less|than|to|above|below|at|least|most|not|empty|contains|starts|ends|with|between|and|or)\\b"
                },
                {
                    "name": "keyword.other.web.plainscript",
                    "match": "\\b(app|route|start|group|allow|cors|validate|status|param|nothing|matches|redirect|folder)\\b"
                },
                {
                    "name": "keyword.other.database.plainscript",
                    "match": "\\b(query|insert|update|delete|execute|transaction|postgres|native|wasm)\\b"
                },
                {
                    "name": "keyword.other.backend.plainscript",
                    "match": "\\b(sessions|session|uploads|limit|requests|api|key|google|oauth|cookie|expires|schedule|background|websocket|socket|connects|disconnects|mail|transport|headers|timeout|cache|redis|database)\\b"
                },
                {
                    "name": "keyword.other.plainscript",
                    "match": "\\b(someone|visits|sends|clicks|matching|on|json|done|get|post|put|patch|use)\\b"
                },
                {
                    "name": "support.function.stdlib.plainscript",
                    "match": "\\b(length|uppercase|lowercase|trim|replace|split|join|number|text|floor|ceiling|random|round|sort|reverse|unique|sum|smallest|largest|keys|values|hasKey|merge|readFile|writeFile|appendFile|fileExists|copyFile|moveFile|deleteFile|makeFolder|deleteFolder|listFolder|readBytes|writeBytes|read|write|sleep|time|date|jsonEncode|jsonDecode|env|exit|uuid|cacheGet|cacheSet|cacheDelete|hashPassword|checkPassword|createToken|readToken|validate|param|query|header|upload|uploads|cookie|sendMessage|sendPhoto|getChat|getMyChats|editMessage|paginate|chat|embedText|similarity|ai_tags|ai_post|typeOf|fieldsOf|valueOf|hasField|sizeOf|base64Encode|base64Decode|textToBytes|bytesToText|sha256|sha1|md5|yamlDecode|yamlEncode|loadModule|runCommand|args|fileSize|fileType|lastModified|walkFolder|joinPath|baseName|folderOf|extensionOf|writeLine|appendLine|keyMap|mapSet|mapGet|mapHas|mapDelete|newSet|addToSet|removeFromSet|setHas|unique|spread|allOf|anyOf|settledOf|withTimeout|range|clamp|first|last|flatten|includes|pick|omit|groupBy|startsWith|endsWith|truncate|padStart|padEnd|loadEnvFile|newDate|now|nowSec|year|month|day|hours|minutes|seconds|toISO|toLocaleDate|toLocaleTime|toUTC|formatDate|addTime|subTime|diffTime|startOfDay|endOfDay|startOfMonth|endOfMonth|startOfYear|endOfYear|parseDate|regex|regexMatch|regexMatchAll|replaceRegex|splitRegex|coalesce)(?=\\s*\\()"
                },
                {
                    "name": "constant.language.plainscript",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.plainscript",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.arithmetic.plainscript",
                    "match": "[+\\-*/%]"
                },
                {
                    "name": "punctuation.accessor.plainscript",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.comma.plainscript",
                    "match": ","
                },
                {
                    "name": "punctuation.section.braces.plainscript",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.separator.key-value.plainscript",
                    "match": ":"
                }
            ]
        },
        "function-names": {
            "patterns": [
                {
                    "comment": "Function declaration: define name(...)",
                    "match": "(?<=\\bdefine\\s+)(\\w+)(?=\\s*\\()",
                    "name": "entity.name.function.plainscript"
                },
                {
                    "comment": "Function call: name(...)",
                    "match": "\\b(\\w+)(?=\\s*\\()",
                    "name": "entity.name.function.call.plainscript"
                }
            ]
        },
        "identifiers": {
            "name": "variable.other.plainscript",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
    }
}
